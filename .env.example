PORT=3030
NODE_ENV=production
SESSION_SECRET=troque-por-uma-string-longa-e-aleatoria
DATA_DIR=/data
DEMO_EMAIL=demo@lifeos.app
DEMO_PASSWORD=LifeOS-Demo-2026!
SESSION_TTL_DAYS=30

# URL pública atrás do Traefik/Cloudflare (sem barra no final)
PUBLIC_BASE_URL=https://lifeos.guilhermesales.com

# Google OAuth + Calendar (mesmo client)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Lista separada por vírgula. Vazio = qualquer e-mail Google (só use assim em dev).
ALLOWED_EMAILS=seu-email@gmail.com

# Criptografa refresh tokens do Google em repouso (AES-256-GCM). Se vazio, deriva de SESSION_SECRET.
TOKEN_ENCRYPTION_KEY=

# Token MCP/API de bootstrap (opcional). Também é possível criar tokens na UI.
MCP_BOOTSTRAP_TOKEN=
# E-mail do usuário que o bootstrap assume. Se vazio, usa o primeiro da allowlist ou o primeiro usuário.
MCP_BOOTSTRAP_USER_EMAIL=

# Fuso padrão das datas do MCP/API
TZ_NAME=America/Sao_Paulo

# Sync periódica do Calendar (0 desliga). Padrão: 15 min
CALENDAR_SYNC_INTERVAL_MS=900000
